# ==============================================================================
# MindVault – Personal Gemini Journal Environment Variables (.env.example)
# ==============================================================================
# NOTE: Never put real credentials or production keys in this file.

# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# Stored securely in Google Cloud Secret Manager or environment variables.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The external URL where this application is hosted (e.g., Cloud Run URL).
APP_URL="https://your-cloud-run-service.run.app"

# PORT: Server port (Default: 3000)
PORT=3000

# NODE_ENV: production | development
NODE_ENV="production"
